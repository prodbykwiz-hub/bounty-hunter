# Скопируй в .env и заполни. Файл .env в git не попадает.

# Тот же бот и чат, что в секретах GitHub Actions
TG_BOT_TOKEN=
TG_CHAT_ID=
# Твой личный числовой id в Telegram: только твои нажатия и ответы принимаются
TG_OWNER_ID=

# Ключ из https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini пишет только сообщения. Pro (gemini-3.1-pro-preview) — только с оплатой
GEMINI_MODEL=gemini-3.8-flash
# Google закрывает Gemini API для части стран ("User location is not supported").
# Можно пустить Gemini через прокси, только его: http://host:port
# GEMINI_PROXY=
# Если Gemini недоступен, сообщения пишет Claude CLI без инструментов (sonnet, haiku, opus)
# CLAUDE_WRITER_MODEL=sonnet

# Аккаунт, от которого агент пишет на GitHub (gh должен быть залогинен под ним)
GITHUB_USER=prodbykwiz-hub

# Необязательно
# WORK_DIR=C:\Users\you\bounty-work
# WATCH_INTERVAL=300
# Код пишет Claude Code CLI (claude -p) по твоей подписке Claude
# CLAUDE_BIN=claude
# CLAUDE_MODEL=opus
# CODER_TIMEOUT=1800
